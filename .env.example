# ---- Sankhya (API Gateway oficial - OAuth 2.0 client_credentials) ----
# client_id / client_secret: Área do Desenvolvedor Sankhya (https://developer.sankhya.com.br)
# X-Token: Sankhya Om > tela "Configurações Gateway"
SANKHYA_BASE_URL=https://api.sankhya.com.br
SANKHYA_CLIENT_ID=
SANKHYA_CLIENT_SECRET=
SANKHYA_X_TOKEN=
# Opcional: filtra uma empresa específica (vazio = todas)
SANKHYA_CODIGO_EMPRESA=
# Opcional: nome curto da empresa no card, por código (senão usa a razão social sem LTDA/ME/...)
# Ex.: EMPRESAS_APELIDOS=1=Casa Contente Matriz;2=Casa Contente Filial
EMPRESAS_APELIDOS=
# Situações consideradas "ativas" (0=demitido e 8=transferido ficam fora por padrão)
SITUACOES_ATIVAS=1,2,3,4,5,6,7,9
# Fotos: busca em TFPFUN.IMAGEM (e na pasta fotos/, que tem prioridade)
MOSTRAR_FOTOS=true

# ---- E-mail (Amazon SES) ----
# Usuário IAM com permissão apenas de ses:SendEmail / ses:SendRawEmail (ver README)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=sa-east-1
# Remetente precisa estar verificado no SES (e-mail ou domínio)
EMAIL_REMETENTE=
# Opcional: configuration set do SES (métricas de entrega/bounce)
SES_CONFIGURATION_SET=
# separados por vírgula
EMAIL_DESTINATARIOS=rh@suaempresa.com.br,rh2@suaempresa.com.br

# ---- Geral ----
NOME_EMPRESA=Casa Contente
TZ_EMPRESA=America/Sao_Paulo
