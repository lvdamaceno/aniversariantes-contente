# ---- Sankhya (API Gateway oficial - OAuth 2.0 client_credentials) ----
# client_id / client_secret: Área do Desenvolvedor Sankhya (https://developer.sankhya.com.br)
# X-Token: Sankhya Om > tela "Configurações Gateway"
SANKHYA_BASE_URL=https://api.sankhya.com.br
SANKHYA_CLIENT_ID=
SANKHYA_CLIENT_SECRET=
SANKHYA_X_TOKEN=
# Opcional: filtra uma empresa específica (vazio = todas)
SANKHYA_CODIGO_EMPRESA=
# Situações consideradas "ativas" (0=demitido e 8=transferido ficam fora por padrão)
SITUACOES_ATIVAS=1,2,3,4,5,6,7,9
# Fotos: tenta buscar na Sankhya (campo IMAGEM de TFPFUN) e na pasta fotos/
MOSTRAR_FOTOS=true
SANKHYA_CAMPO_FOTO=IMAGEM

# ---- E-mail (SMTP) ----
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_REMETENTE=
# separados por vírgula
EMAIL_DESTINATARIOS=rh@suaempresa.com.br,rh2@suaempresa.com.br

# ---- Geral ----
NOME_EMPRESA=Casa Contente
TZ_EMPRESA=America/Sao_Paulo
